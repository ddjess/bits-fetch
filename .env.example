# Copy this file to .env and fill in your values. .env is git-ignored.

# Datadog API key (Organization Settings > API Keys)
DD_API_KEY=

# Datadog site. US1 = datadoghq.com
DD_SITE=datadoghq.com

# Browser RUM app (Digital Experience > RUM > your app > Settings)
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=

# Failure modes (0.0 - 1.0). Defaults add up to roughly 15% failed fetches.
SQUIRREL_RATE=0.06
BONE_LOST_RATE=0.06
CRASH_RATE=0.03
MUD_RATE=0.10
